// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum ProjectType {
  MAIN
  SIDE
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

model Project {
  id            Int         @id @default(autoincrement())
  title         String
  description   String?     @db.Text
  dueAt         DateTime    @db.Timestamptz(3)                                @map("due_at")
  userId        Int                                                           @map("user_id")
  type          ProjectType
  importance    Int         @default(1)
  estimatedTime Int         @default(0)                                       @map("estimated_min")
  createdAt     DateTime    @db.Timestamptz(3) @default(now())                @map("created_at")
  lastUpdate    DateTime    @db.Timestamptz(3) @default(now()) @updatedAt     @map("last_update")
  status        ProjectStatus  @default(ACTIVE) 

  tasks         Task[]

  user          User?       @relation(fields: [userId], references: [id])

  @@map("project")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model Task {
  id            Int         @id @default(autoincrement())
  title         String      @db.VarChar(255)
  description   String?     @db.Text
  dueAt         DateTime    @db.Timestamptz(3)                                @map("due_at")
  status        TaskStatus  @default(PENDING)
  userId        Int                                                           @map("user_id")
  projectId     Int?                                                          @map("project_id")
  importance    Int         @default(1)
  estimatedTime Int         @default(1)                                       @map("estimated_time")
  blocks        TaskBlock[] @relation("Blocks")
  blockedBy     TaskBlock[] @relation("BlockedBy")
  createdAt     DateTime    @db.Timestamptz(3) @default(now())                @map("created_at")
  lastUpdate    DateTime    @db.Timestamptz(3) @default(now()) @updatedAt     @map("last_update")
  completedAt   DateTime?                                                     @map("completed_at")
  timerId       Int?        @unique                                           @map("timer_id")

  project       Project?    @relation(fields: [projectId], references: [id])
  user          User?       @relation(fields: [userId], references: [id])
  timer         Timer?      @relation(fields: [timerId], references: [id])

  @@map("task")
}

model TaskBlock {
  blockerId     Int         @map("blocker_id")
  blockedId     Int         @map("blocked_id")

  blocker       Task        @relation("Blocks", fields: [blockerId], references: [id])
  blocked       Task        @relation("BlockedBy", fields: [blockedId], references: [id])

  @@id([blockerId, blockedId])

  @@index([blockedId])
  @@index([blockerId])

  @@map("task_block")
}

model Timer {
  id              Int       @id @default(autoincrement())
  firstStartTime  DateTime  @db.Timestamptz(3)  @default(now()) @map("first_start_time")
  startTime       DateTime  @db.Timestamptz(3)  @default(now()) @map("start_time")
  endTime         DateTime? @db.Timestamptz(3)                  @map("end_time")
  duration        Int       @default(0)                         @map("duration")
  running         Boolean   @default(true)

  task Task?

  @@map("timer")
}

enum UserLanguage {
  ENGLISH
  FRENCH
}

enum UserTheme {
  SYSTEM
  LIGHT
  DARK
}

model User {
  id              Int           @id @default(autoincrement())
  username        String        @unique @db.VarChar(255)
  email           String        @unique
  password        String        @db.VarChar(255)
  createdAt       DateTime      @db.Timestamptz(3) @default(now())                @map("created_at")
  lastUpdate      DateTime      @db.Timestamptz(3) @default(now()) @updatedAt     @map("last_update")
  xp              Int           @default(0)
  level           Int           @default(1)
  language        UserLanguage  @default(ENGLISH)
  theme           UserTheme     @default(LIGHT)
  avatarPath      String?       @db.VarChar(255) @map("avatar_path")
  avatarMime      String?       @db.VarChar(255) @map("avatar_mime")
  avatarSize      Int?          @map("avatar_size")
  avatarUpdatedAt DateTime?     @db.Timestamptz(3) @updatedAt                     @map("avatar_updated_at")

  projects       Project[]
  tasks          Task[]

  friends        UserFriends[]  @relation("UserFriends")
  friendOf       UserFriends[]  @relation("FriendOf")

  @@map("user")
}

enum UserFriendState {
  PENDING
  REQUESTED
  CONFIRMED
}

model UserFriends {
  userId    Int                                                                          @map("user_id")
  friendId  Int                                                                          @map("friend_id")
  state     UserFriendState @default(PENDING)

  user      User            @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend    User            @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@index([state], name: "idx_state")

  @@map("user_friends")
}
